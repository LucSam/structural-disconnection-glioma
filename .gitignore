# Track only source, documentation and the four reviewed metadata files.
# Local study data, results, figures, caches and environment files stay ignored.
*
!/.gitignore
!/README.md
!/requirements.txt
!/scripts/
!/scripts/*.py
!/tests/
!/tests/test_nemo_graph_loading.py
!/docs/
!/docs/*.md
!/metadata/
!/metadata/software_versions.json
!/metadata/table_export_metadata.json
!/metadata/figure_generation_provenance.csv
!/metadata/output_checksums_sha256.csv
