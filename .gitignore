# Allow only reviewed source, documentation and public release metadata.
# Study data, generated results, manuscripts, caches and local metadata stay ignored.
*
!/.gitignore
!/README.md
!/CHANGELOG.md
!/LICENSE
!/requirements.txt
!/scripts/
!/scripts/*.py
!/tests/
!/tests/*.py
!/docs/
!/docs/*.md
!/metadata/
!/metadata/software_versions.json
!/metadata/code_snapshot.json
